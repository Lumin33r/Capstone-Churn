{
  "qa_score": {
    "type": "numeric",
    "encoding": "passthrough"
  },

  "sentiment": {
    "type": "categorical",
    "encoding": "label_encode",
    "mapping": {
      "Negative": 0,
      "Neutral": 1,
      "Positive": 2
    }
  },

  "category": {
    "type": "categorical",
    "encoding": "one_hot"
  },

  "confidence": {
    "type": "numeric",
    "encoding": "passthrough"
  },

  "frustration_level": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "call_duration_indicator": {
    "type": "categorical",
    "encoding": "label_encode",
    "mapping": {
      "short": 0,
      "medium": 1,
      "long": 2
    }
  },

  "escalation_flag": {
    "type": "boolean",
    "encoding": "binary"
  },
  "customer_age": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "income_bracket": {
    "type": "categorical",
    "encoding": "one_hot"
  },

  "plan_type": {
    "type": "categorical",
    "encoding": "one_hot"
  },

  "recent_overages_count": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "customer_service_count": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "customer_issue_history": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "call_duration_seconds": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "num_turns": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "customer_talk_ratio": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "agent_talk_ratio": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "interruptions_count": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "sentiment_shift": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "word_count": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "avg_word_length": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "num_negative_words": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "num_positive_words": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "num_exclamation_marks": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "toxicity_score": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "emotion_scores": {
    "type": "vector",
    "encoding": "passthrough",
    "dimensions": [
      "anger",
      "sadness",
      "frustration",
      "fear",
      "disgust",
      "joy",
      "surprise",
      "confusion",
      "neutral"
    ]
  },

  "billing_dispute_flag": {
    "type": "boolean",
    "encoding": "binary"
  },

  "outage_history_flag": {
    "type": "boolean",
    "encoding": "binary"
  },

  "overage_amount_last_cycle": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "agent_experience": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "transfer_count": {
    "type": "numeric",
    "encoding": "normalize"
  },

  "resolution_flag": {
    "type": "boolean",
    "encoding": "binary"
  }
}
